<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> IP</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: system-ui, Arial, sans-serif;
      margin: 0;
