#!/bin/bash
set -euo pipefail

###############################
# Auto Proxy / Tor Checker
# Multi-thread, IPv4/IPv6
# Truncate old logs automatically
###############################

# -------------------------------
# Detect distro
detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$ID"
    else
        uname -s
    fi
}

# -------------------------------
# Install package if missing
install_if_missing() {
    local pkg="$1"
    local distro="$2"

    case "$distro" in
        ubuntu|debian|kali)
            dpkg -s "$pkg" >/dev/null 2>&1 || apt-get install -y "$pkg"
            ;;
        centos|rhel)
            rpm -q "$pkg" >/dev/null 2>&1 || yum install -y "$pkg"
            ;;
        fedora|centos|rhel8|rhel9|almalinux)
            rpm -q "$pkg" >/dev/null 2>&1 || dnf install -y "$pkg"
            ;;
        *)
            echo "Unsupported distro $distro, please install $pkg manually"
            ;;
    esac
}

# -------------------------------
# Install required tools
DISTRO=$(detect_distro)
TOOLS=(curl jq net-tools lsof awk grep xargs sudo)
for pkg in "${TOOLS[@]}"; do
    install_if_missing "$pkg" "$DISTRO"
done

echo "[*] Required tools installed or already present."

# -------------------------------
# Remove old results
[ -f live_proxy.txt ] && rm -f live_proxy.txt
[ -f die_proxy.txt ] && rm -f die_proxy.txt
[ -f proxy_results.log ] && rm -f proxy_results.log
[ -f port.txt ] && rm -f port.txt

# -------------------------------
# Get list of listening ports
ports=$( (netstat -tuln 2>/dev/null | awk '/LISTEN/{print $4}' | grep -oE '[0-9]+$' ; \
         lsof -i -P -n 2>/dev/null | grep LISTEN | awk '{print $9}' | grep -oE '[0-9]+$') | sort -nu )

echo "[*] Detected listening ports: $ports"

# -------------------------------
# Functions
get_ip(){
    local port="$1"
    local ip=""
    for svc in https://api64.ipify.org https://httpbin.org/ip https://ifconfig.me http://ipecho.net/plain; do
        ip=$(curl -s --max-time 15 --proxy http://localhost:$port $svc | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}")
        [ -n "$ip" ] && break
    done
    echo "$ip"
}

get_country(){
    local ip="$1"
    local attempts=0
    local country=""
    local apis=(http://ip-api.com/json/$ip https://ipinfo.io/$ip/json https://ipwhois.app/json/$ip)
    while [[ -z "$country" || "$country"=="null" || "$country"=="Không xác định" ]] && [ $attempts -lt 2 ]; do
        for api in "${apis[@]}"; do
            country=$(curl -s --max-time 15 "$api" | jq -r ".country")
            [[ -n "$country" && "$country" != "null" ]] && break
        done
        attempts=$((attempts+1))
    done
    [ -z "$country" ] && country="Không xác định"
    echo "$country"
}

# -------------------------------
# Process each port in parallel
echo "$ports" | xargs -I{} -P200 bash -c '
port="{}"

# Redefine functions in subshell
get_ip(){
    local port="$1"
    local ip=""
    for svc in https://api64.ipify.org https://httpbin.org/ip https://ifconfig.me http://ipecho.net/plain; do
        ip=$(curl -s --max-time 15 --proxy http://localhost:$port $svc | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}")
        [ -n "$ip" ] && break
    done
    echo "$ip"
}

get_country(){
    local ip="$1"
    local attempts=0
    local country=""
    local apis=(http://ip-api.com/json/$ip https://ipinfo.io/$ip/json https://ipwhois.app/json/$ip)
    while [[ -z "$country" || "$country"=="null" || "$country"=="Không xác định" ]] && [ $attempts -lt 2 ]; do
        for api in "${apis[@]}"; do
            country=$(curl -s --max-time 15 "$api" | jq -r ".country")
            [[ -n "$country" && "$country" != "null" ]] && break
        done
        attempts=$((attempts+1))
    done
    [ -z "$country" ] && country="Không xác định"
    echo "$country"
}

ip=$(get_ip "$port")
if [ -n "$ip" ] && [ "$ip" != "null" ]; then
    country=$(get_country "$ip")
    speed=$(curl -s --max-time 15 --proxy http://localhost:$port http://speedtest.tele2.net/500MB.zip -o /dev/null -w "%{speed_download}" | awk "{printf \"%.2f Mbps\", \$1/1024/1024}")
    facebook_speed=$(curl -s --max-time 15 --proxy http://localhost:$port -o /dev/null -w "%{time_total}" "https://www.facebook.com" | awk "{printf \"%.2f s\", \$1}")
    echo "✅ Port $port | IP: $ip | Quốc gia: $country | Tốc độ: $speed | Facebook load: $facebook_speed" | tee -a live_proxy.txt
else
    echo "❌ Port $port failed" | tee -a die_proxy.txt
fi
' | tee proxy_results.log

# -------------------------------
# Save ports to file
netstat -tuln 2>/dev/null | awk '/LISTEN/ {print $4}' | grep -oE '[0-9]+$' | sort -n | uniq > cong.txt

echo "[*] Proxy check complete. Results in live_proxy.txt / die_proxy.txt / proxy_results.log"
