    local ip="$1"
    local attempts=0
    local country=""
    local apis=(http://ip-api.com/json/$ip https://ipinfo.io/$ip/json https://ipwhois.app/json/$ip)
    while [[ -z "$country" || "$country"=="null" || "$country"=="Không xác định" ]] && [ $attempts -lt 2 ]; do
        for api in "${apis[@]}"; do
            country=$(curl -s --max-time 15 "$api" | jq -r ".country")
            [[ -n "$country" && "$country" != "null" ]] && break
        done
        attempts=$((attempts+1))
    done
    [ -z "$country" ] && country="Không xác định"
    echo "$country"
}

ip=$(get_ip "$port")
if [ -n "$ip" ] && [ "$ip" != "null" ]; then
    country=$(get_country "$ip")
    speed=$(curl -s --max-time 15 --proxy http://localhost:$port http://speedtest.tele2.net/500MB.zip -o /dev/null -w "%{speed_download}" | awk "{printf \"%.2f Mbps\", \$1/1024/1024}")
    facebook_speed=$(curl -s --max-time 15 --proxy http://localhost:$port -o /dev/null -w "%{time_total}" "https://www.facebook.com" | awk "{printf \"%.2f s\", \$1}")
    echo "✅ Port $port | IP: $ip | Quốc gia: $country | Tốc độ: $speed | Facebook load: $facebook_speed" | tee -a live_proxy.txt
else
    echo "❌ Port $port failed" | tee -a die_proxy.txt
fi
' | tee proxy_results.log

# Save ports to file
netstat -tuln 2>/dev/null | awk '/LISTEN/ {print $4}' | grep -oE '[0-9]+$' | sort -n | uniq > cong.txt

      
