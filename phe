#!/bin/bash
set +euo pipefail

###############################
# Auto Proxy / Tor Checker
# Multi-thread, IPv4/IPv6
apt-get update -y && apt-get install -y  >/dev/null 2>&1
yum install -y curl jq net-tools lsof gawk grep xargs sudo >/dev/null 2>&1
dnf install -y curl jq net-tools lsof gawk grep xargs sudo >/dev/null 2>&1
# -------------------------------
# Get list of listening ports
ports=$( (netstat -tuln 2>/dev/null | awk '/LISTEN/{print $4}' | grep -oE '[0-9]+$' ; \
         lsof -i -P -n 2>/dev/null | grep LISTEN | awk '{print $9}' | grep -oE '[0-9]+$') | sort -nu )

echo "[*] Detected listening ports: $ports"

# -------------------------------
# Functions
get_ip(){
    local port="$1"
    local ip=""
    for svc in https://api64.ipify.org https://httpbin.org/ip https://ifconfig.me http://ipecho.net/plain; do
        ip=$(curl -s --max-time 10 --proxy http://localhost:$port $svc 2>/dev/null | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}")
        [ -n "$ip" ] && break
    done
    echo "$ip"
}

get_country(){
    local ip="$1"
    local country=""
    local apis=(http://ip-api.com/json/$ip https://ipinfo.io/$ip/json https://ipwhois.app/json/$ip)
    for api in "${apis[@]}"; do
        country=$(curl -s --max-time 10 "$api" 2>/dev/null | jq -r ".country" 2>/dev/null)
        [ -n "$country" ] && break
    done
    [ -z "$country" ] && country="Không xác định"
    echo "$country"
}

# -------------------------------
# Process each port in parallel
echo "$ports" | xargs -I{} -P50 bash -c '
port="{}"
ip=$(get_ip "$port")
if [ -n "$ip" ] && [ "$ip" != "null" ]; then
    country=$(get_country "$ip")
    echo "✅ Port $port | IP: $ip | Quốc gia: $country" >> live_proxy.txt 2>/dev/null
else
    echo "❌ Port $port failed" >> die_proxy.txt 2>/dev/null
fi
'

# -------------------------------
# Save ports to file
echo "$ports" > cong.txt 2>/dev/null

echo "[*] Proxy/Tor check complete. Results in live_proxy.txt / die_proxy.txt / cong.txt"
