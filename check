#!/bin/bash

# Automatically install necessary tools
echo "Installing required tools: net-tools, jq, lsof..."
sudo apt update && sudo apt install -y net-tools jq lsof curl || { echo "Failed to install tools. Please check your permissions."; exit 1; }

# Collect all open ports using netstat or lsof
(
  netstat -tuln 2>/dev/null | awk '/LISTEN/{print $4}' | grep -oE '[0-9]+$' || \
  lsof -i -P -n 2>/dev/null | grep LISTEN | awk '{print $9}' | grep -oE '[0-9]+$'
) | sort -nu | \
xargs -I{} -P200 bash -c '
port="{}";

# Function to get the public IP via the proxy
get_ip() {
  for svc in https://api64.ipify.org https://httpbin.org/ip https://ifconfig.me http://ipecho.net/plain; do
    ip=$(curl -s --max-time 15 --proxy http://localhost:$port "$svc" | grep -oE "([0-9]{1,3}\\.){3}[0-9]{1,3}")
    [[ -n "$ip" ]] && echo "$ip" && return 0
  done
  echo ""
}

# Function to get the country based on the IP
get_country() {
  local ip="$1"
  local country=""
  local attempts=0
  local apis=( "http://ip-api.com/json/$ip" "https://ipinfo.io/$ip/json" "https://ipwhois.app/json/$ip" )

  while { [[ -z "$country" ]] || [[ "$country" == "null" ]] || [[ "$country" == "Không xác định" ]]; } && [[ $attempts -lt 2 ]]; do
    for api in "${apis[@]}"; do
      country=$(curl -s --max-time 15 "$api" | jq -r ".country")
      [[ -n "$country" && "$country" != "null" ]] && echo "$country" && return 0
    done
    ((attempts++))
    ip=$(get_ip)  # Retry IP if needed
  done

  echo "Không xác định"
}

# Function to calculate download speed
get_speed() {
  curl -s --max-time 15 --proxy http://localhost:$port http://speedtest.tele2.net/100MB.zip -o /dev/null -w "%{speed_download}" | \
  awk "{printf \"%.2f Mbps\", \$1/1024/1024}"
}

# Function to measure Facebook load time
get_facebook_speed() {
  curl -s --max-time 15 --proxy http://localhost:$port -o /dev/null -w "%{time_total}" https://www.facebook.com | \
  awk "{printf \"%.2f s\", \$1}"
}

# Main logic
ip=$(get_ip)
if [[ -n "$ip" ]]; then
  country=$(get_country "$ip")
  speed=$(get_speed)
  facebook_speed=$(get_facebook_speed)
  echo "✅ Cổng $port | IP: $ip | Quốc gia: $country | Speed: $speed | FB Load: $facebook_speed" | tee -a live_proxy.txt
else
  echo "❌ Port $port failed" | tee -a die_proxy.txt
fi
' | tee proxy_results.log
