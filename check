#!/bin/bash
set -e

# ✅ Kiểm tra quyền root
[ "$EUID" -ne 0 ] && { echo "⚠️ Chạy script với root"; exit 1; }

# Tool cần thiết
TOOLS=(curl jq nmap xargs awk)
for t in "${TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq "$t" || true; }
done

# Dọn file cũ
rm -f live_proxy.txt die_proxy.txt cong.txt 2>/dev/null
touch live_proxy.txt die_proxy.txt cong.txt

CPU=$(nproc)

# Hàm lấy IP qua proxy
get_ip(){
    local port="$1"
    for svc in https://api64.ipify.org https://httpbin.org/ip https://ifconfig.me; do
        ip=$(curl -s --max-time 5 --proxy http://localhost:$port $svc | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}")
        [ -n "$ip" ] && break
    done
    echo "${ip:-null}"
}

# Hàm lấy quốc gia từ IP
get_country(){
    local ip="$1"
    local country=""
    for api in http://ip-api.com/json/$ip https://ipinfo.io/$ip/json https://ipwhois.app/json/$ip; do
        country=$(curl -s --max-time 5 "$api" | jq -r ".country" 2>/dev/null)
        [[ -n "$country" && "$country" != "null" ]] && break
    done
    echo "${country:-Không xác định}"
}

export -f get_ip get_country

# 🔎 Quét port TCP mở localhost bằng nmap
echo "⏳ Quét port TCP localhost..."
open_ports=$(nmap -p 1-65535 -T4 -sT 127.0.0.1 2>/dev/null | grep "open" | awk '{print $1}' | cut -d'/' -f1)
echo "✅ Port mở: $open_ports"

# ✅ Kiểm tra proxy song song
echo "$open_ports" | xargs -I{} -P$((CPU*4)) bash -c '
port="{}"
ip=$(get_ip "$port")
if [ "$ip" != "null" ]; then
    country=$(get_country "$ip")
    speed=$(curl -s --max-time 5 --proxy http://localhost:$port http://speedtest.tele2.net/1MB.zip -o /dev/null -w "%{speed_download}" | awk "{printf \"%.2f Mbps\", \$1/1024/1024}")
    echo "✅ Port $port | IP: $ip | Quốc gia: $country | Tốc độ: $speed" | tee -a live_proxy.txt
fi
'

# Lưu danh sách port sống
awk -F '|' '{print $2}' live_proxy.txt | grep -oE '[0-9]+$' | sort -n > cong.txt

# Tổng kết
echo -e "\n🎉 Hoàn tất lúc: $(date)"
echo "✅ Proxy sống: $(wc -l < live_proxy.txt)"
