<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facebook UID Live Checker</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; text-align: center; }
        textarea, input, button { margin: 10px; padding: 10px; font-size: 16px; }
        #results { display: flex; justify-content: center; gap: 20px; margin-top: 20px; }
        .box { width: 45%; padding: 10px; border-radius: 5px; text-align: left; }
        .live { background-color: #d4edda; color: #155724; }
        .dead { background-color: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
    <h1>Facebook UID Live Checker</h1>

    <input type="file" id="fileInput" accept=".txt">
    <textarea id="uidInput" placeholder="Nhập danh sách UID..." rows="5" cols="50"></textarea>
    <button onclick="checkUIDs()">✅ Kiểm tra UIDs</button>
    <button onclick="copyLiveUIDs()" id="copyButton" style="display:none;">📋 Copy Live UIDs</button>

    <div id="results">
        <div class="box live">
            <h3>✅ Live UIDs (<span id="countLive">0</span>)</h3>
            <textarea id="ListLive" rows="10" cols="30" readonly></textarea>
        </div>
        <div class="box dead">
            <h3>❌ Dead UIDs (<span id="countDead">0</span>)</h3>
            <textarea id="ListDead" rows="10" cols="30" readonly></textarea>
        </div>
    </div>

    <script>
        // Tải file TXT lên nhưng không tự động chạy
        document.getElementById('fileInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('uidInput').value = e.target.result;
            };
            reader.readAsText(file);
        });

        // Kiểm tra danh sách UID khi bấm nút
        async function checkUIDs() {
            let uidList = document.getElementById('uidInput').value.trim().split("\n").map(uid => uid.trim()).filter(uid => uid);
            if (uidList.length === 0) {
                alert("Vui lòng nhập hoặc tải lên danh sách UID.");
                return;
            }

            document.getElementById('ListLive').value = "";
            document.getElementById('ListDead').value = "";
            document.getElementById('countLive').textContent = "0";
            document.getElementById('countDead').textContent = "0";

            let liveCount = 0, deadCount = 0;
            let workers = [];
            let batchSize = Math.ceil(uidList.length / navigator.hardwareConcurrency); // Chia nhỏ theo CPU

            for (let i = 0; i < navigator.hardwareConcurrency; i++) {
                let batch = uidList.slice(i * batchSize, (i + 1) * batchSize);
                if (batch.length === 0) continue;

                let worker = new Worker(URL.createObjectURL(new Blob([`
                    onmessage = async function(e) {
                        let live = [], dead = [];
                        for (let uid of e.data) {
                            try {
                                let res = await fetch('https://graph.facebook.com/' + uid + '/picture?type=normal');
                                if (res.ok && !res.url.includes("//static")) {
                                    live.push(uid);
                                } else {
                                    dead.push(uid);
                                }
                            } catch {
                                dead.push(uid);
                            }
                        }
                        postMessage({ live, dead });
                    };
                `], { type: "application/javascript" })));

                worker.postMessage(batch);
                worker.onmessage = function(e) {
                    let { live, dead } = e.data;
                    liveCount += live.length;
                    deadCount += dead.length;
                    document.getElementById('countLive').textContent = liveCount;
                    document.getElementById('countDead').textContent = deadCount;
                    document.getElementById('ListLive').value += live.join("\n") + "\n";
                    document.getElementById('ListDead').value += dead.join("\n") + "\n";
                    if (liveCount > 0) document.getElementById('copyButton').style.display = "inline-block";
                };
                workers.push(worker);
            }

            alert("✅ Kiểm tra đang chạy! Kết quả sẽ hiển thị dần dần.");
        }

        // Sao chép UID Live vào clipboard
        function copyLiveUIDs() {
            let liveUIDs = document.getElementById('ListLive').value;
            if (!liveUIDs.trim()) {
                alert("Không có UID nào để sao chép.");
                return;
            }
            navigator.clipboard.writeText(liveUIDs).then(() => alert("✅ Đã sao chép Live UIDs!"));
        }
    </script>
</body>
</html>
